# Not synced by Argo (it lives outside backstage/deploy). Fill in and apply by hand, then delete the filled copy:
#   kubectl apply -f secret.yaml
apiVersion: v1
kind: Secret
metadata:
  name: backstage-secrets
  namespace: backstage
type: Opaque
stringData:
  POSTGRES_USER: backstage
  POSTGRES_PASSWORD: <random>
  GITHUB_TOKEN: <classic PAT with repo scope, for oamitpg/crossplane-demo>
  AUTH_GITHUB_CLIENT_ID: <GitHub OAuth App client id>
  AUTH_GITHUB_CLIENT_SECRET: <GitHub OAuth App client secret>
